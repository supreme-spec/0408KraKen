generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Camera {
  id                   Int         @id @default(autoincrement())
  name                 String
  source               String
  camera_type          String      @default("USB")
  zone                 String?
  is_active            Boolean     @default(true)
  created_at           DateTime    @default(now())
  status               String      @default("offline")
  roi_zones            String?
  fps                  Int         @default(25)
  ping_ms              Int         @default(0)
  is_smart_recording   Boolean     @default(false)
  is_chronicle         Boolean     @default(true)
  driver_type          String?
  ip_address           String?
  ip_port              Int?
  username             String?
  password             String?
  use_camera_analytics Boolean     @default(false)
  enabled_modules      String      @default("face")
  motion_threshold     Float?      @default(0.62)
  motion_zones         String?
  lpr_enabled          Boolean     @default(false)
  lpr_regions          String?
  exclusion_zones      String?
  webhookSecret        String?     @unique
  vendor               String?
  model_name           String?
  firmware             String?
  serial_number        String?
  mac_address          String?
  onvif_supported      Boolean     @default(false)
  probe_source         String?
  probe_updated_at     DateTime?
  stream_profiles      String?
  data_confidence      String?
  last_verified_at     DateTime?
  ai_stream_profile_id String?
  events               Event[]
  recordings           Recording[]
}

model Category {
  id                 Int     @id @default(autoincrement())
  code               String  @unique
  label              String
  color              String
  bg_color           String
  is_alert           Boolean @default(false)
  alert_sound        String  @default("off")
  alert_volume       Float   @default(0.5)
  detect_enabled     Boolean @default(true)
  sort_order         Int     @default(100)
  is_system          Boolean @default(false)
  card_template_json String?
}

model Guest {
  id           Int       @id @default(autoincrement())
  name         String    @default("Неизвестный")
  photo_path   String?
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now())
  last_seen_at DateTime?
  visit_count  Int       @default(0)
  confidence   Float?
  camera_id    Int?
  camera_name  String?
  events       Event[]
}

model Person {
  id                 Int      @id @default(autoincrement())
  name               String
  category           String
  position           String?
  comment            String?
  phone              String?
  email              String?
  birth_date         String?
  address            String?
  organization       String?
  extra_info         String?
  photo_path         String?
  is_active          Boolean            @default(true)
  created_at         DateTime           @default(now())
  last_seen_at       DateTime?
  visit_count        Int                @default(0)
  embedding_count    Int                @default(0)
  loyalty_index      Float              @default(0.0)
  total_visits       Int                @default(0)
  vip_level          String?
  custom_fields_json String?
  import_review      Boolean            @default(false)
  import_reason      String?
  import_raw_name    String?
  episode_persons    EpisodePerson[]
  events             Event[]
  descriptors        FaceDescriptor[]
  incidents          Incident[]
  category_history   PersonCategoryHistory[]
  policies           PersonPolicy[]
  tags               Tag[]
  confirmations      FaceConfirmation[]
  photos             PersonPhoto[]
  visits             PersonVisit[]
  loyaltyIndex       Int      @default(0)
  needsLoyaltyUpdate Boolean  @default(false)

  @@index([needsLoyaltyUpdate])
}

model PersonVisit {
  id          Int      @id @default(autoincrement())
  person_id   Int
  camera_id   Int?
  camera_name String?
  confidence  Float?
  visit_date  DateTime @default(now())
  source      String   @default("recognition")
  created_at  DateTime @default(now())
  person      Person   @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([person_id])
  @@index([person_id, visit_date])
  @@index([visit_date])
  @@map("person_visits")
}

model FaceDescriptor {
  id         Int      @id @default(autoincrement())
  person_id  Int
  photo_path String
  descriptor String
  created_at DateTime @default(now())
  person     Person   @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([person_id])
}

model PersonPhoto {
  id            Int      @id @default(autoincrement())
  person_id     Int
  photo_path    String
  is_primary    Boolean  @default(false)
  has_embedding Boolean  @default(false)
  source        String   @default("manual")
  confidence    Float?
  created_at    DateTime @default(now())
  person        Person   @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([person_id])
  @@map("person_photos")
}

model FaceConfirmation {
  id                  Int       @id @default(autoincrement())
  person_id           Int
  confidence          Float
  temp_photo_path     String
  existing_photo_path String?
  person_name         String?
  category            String?
  status              String    @default("PENDING")
  created_at          DateTime  @default(now())
  confirmed_at        DateTime?
  confirmed_by        String?
  rejected_reason     String?
  person              Person    @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([person_id])
  @@map("face_confirmations")
}

model Event {
  id                          Int      @id @default(autoincrement())
  camera_id                   Int
  camera_name                 String
  person_id                   Int?
  guest_id                    Int?
  event_type                  String
  confidence                  Float
  threshold                   Float?
  snapshot_path               String?
  person_name                 String?
  person_category             String?
  person_photo_path           String?
  created_at                  DateTime @default(now())
  needs_operator_confirmation Boolean  @default(false)
  confirmation_status         String?
  confirmation_id             Int?
  categoryCode                String?
  alerted                     Boolean  @default(false)
  alertAcked                  Boolean  @default(false)
  alertAckAt                  DateTime?
  person                      Person?  @relation(fields: [person_id], references: [id])
  guest                       Guest?   @relation(fields: [guest_id], references: [id], onDelete: Cascade)
  camera                      Camera   @relation(fields: [camera_id], references: [id], onDelete: Cascade)

  @@index([camera_id])
  @@index([person_id])
  @@index([guest_id])
  @@index([created_at])
  @@index([confirmation_id])
  @@index([alerted, alertAcked])
}

model Recording {
  id          Int      @id @default(autoincrement())
  camera_id   Int
  camera_name String
  start_time  DateTime
  end_time    DateTime
  duration    Int
  size_mb     Float
  video_path  String
  is_favorite Boolean  @default(false)
  camera      Camera   @relation(fields: [camera_id], references: [id], onDelete: Cascade)
}

model Incident {
  id            Int      @id @default(autoincrement())
  person_id     Int
  incident_type String
  severity      String
  comment       String?
  status        String   @default("open")
  created_at    DateTime @default(now())
  person        Person   @relation(fields: [person_id], references: [id], onDelete: Cascade)
}

model PersonCategoryHistory {
  id          Int      @id @default(autoincrement())
  person_id   Int
  old_code    String?
  new_code    String
  reason      String?
  changed_by  String?  @default("operator")
  created_at  DateTime @default(now())
  person      Person   @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([person_id])
  @@index([created_at])
  @@map("person_category_history")
}

model Tag {
  id        Int    @id @default(autoincrement())
  person_id Int
  tag       String
  person    Person @relation(fields: [person_id], references: [id], onDelete: Cascade)
}

/// Контекстные роли персоны (зона/время/тип эпизода)
model PersonPolicy {
  id            Int     @id @default(autoincrement())
  person_id     Int
  zone_id       Int?
  zone_name     String?
  schedule_type String  @default("default")
  start_time    String?
  end_time      String?
  role          String  @default("unknown")
  confidence    Float   @default(0.5)
  label_source  String  @default("operator")
  created_at    String  @default("strftime('%Y-%m-%d %H:%M:%f', 'now')")
  updated_at    String  @default("strftime('%Y-%m-%d %H:%M:%f', 'now')")
  comment       String?
  person        Person  @relation(fields: [person_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([role], map: "idx_PersonPolicy_role")
  @@index([zone_id], map: "idx_PersonPolicy_zone_id")
  @@index([person_id], map: "idx_PersonPolicy_person_id")
}

/// Эпизод (папка с фото/видео)
model Episode {
  id              Int             @id @default(autoincrement())
  folder_path     String          @unique(map: "sqlite_autoindex_Episode_1")
  episode_name    String
  source_type     String          @default("camera")
  capture_time    String?
  camera_id       Int?
  camera_name     String?
  total_photos    Int             @default(0)
  processed_at    String?
  status          String          @default("pending")
  error_message   String?
  created_at      String          @default("strftime('%Y-%m-%d %H:%M:%f', 'now')")
  photos          ArchivePhoto[]
  clustering_logs ClusteringLog[]
  persons         EpisodePerson[]
  clusters        FaceCluster[]

  @@index([status], map: "idx_Episode_status")
  @@index([folder_path], map: "idx_Episode_folder_path")
}

/// Связь между эпизодом и персоной (контекстная роль в этом эпизоде)
model EpisodePerson {
  id            Int           @id @default(autoincrement())
  episode_id    Int
  person_id     Int?
  person_name   String?
  role          String        @default("unknown")
  confidence    Float         @default(0.5)
  label_source  String        @default("operator")
  cluster_id    String?
  is_merge_hint Int           @default(0)
  created_at    String        @default("strftime('%Y-%m-%d %H:%M:%f', 'now')")
  updated_at    String        @default("strftime('%Y-%m-%d %H:%M:%f', 'now')")
  faces         ArchiveFace[]
  person        Person?       @relation(fields: [person_id], references: [id], onUpdate: NoAction)
  episode       Episode       @relation(fields: [episode_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([role], map: "idx_EpisodePerson_role")
  @@index([person_id], map: "idx_EpisodePerson_person_id")
  @@index([episode_id], map: "idx_EpisodePerson_episode_id")
}

/// Архивное фото (оригинальное изображение из архива)
model ArchivePhoto {
  id            Int           @id @default(autoincrement())
  episode_id    Int
  photo_path    String
  filename      String
  width         Int?
  height        Int?
  source_width  Int?
  source_height Int?
  source_type   String?
  osd_text      String?
  quality_score Float?
  tier          String?
  profile       String?
  processed_at  String?
  status        String        @default("pending")
  created_at    String        @default("strftime('%Y-%m-%d %H:%M:%f', 'now')")
  faces         ArchiveFace[]
  episode       Episode       @relation(fields: [episode_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([processed_at], map: "idx_ArchivePhoto_processed_at")
  @@index([episode_id], map: "idx_ArchivePhoto_episode_id")
}

/// Архивное лицо (детектированное на архивном фото)
model ArchiveFace {
  id                Int            @id @default(autoincrement())
  photo_id          Int
  episode_person_id Int?
  cluster_id        Int?
  bbox_x            Float
  bbox_y            Float
  bbox_w            Float
  bbox_h            Float
  det_score         Float?
  kps               String?
  pitch_deg         Float?
  yaw_deg           Float?
  blur_score        Float?
  brightness        Float?
  occlusion         Float?
  quality_score     Float?
  tier              String?
  embedding         String?
  embedding_model   String?
  status            String         @default("detected")
  reject_reason     String?
  created_at        String         @default("strftime('%Y-%m-%d %H:%M:%f', 'now')")
  processed_at      String?
  cluster           FaceCluster?   @relation(fields: [cluster_id], references: [id], onUpdate: NoAction)
  episode_person    EpisodePerson? @relation(fields: [episode_person_id], references: [id], onUpdate: NoAction)
  photo             ArchivePhoto   @relation(fields: [photo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_ArchiveFace_status")
  @@index([tier], map: "idx_ArchiveFace_tier")
  @@index([cluster_id], map: "idx_ArchiveFace_cluster_id")
  @@index([episode_person_id], map: "idx_ArchiveFace_episode_person_id")
  @@index([photo_id], map: "idx_ArchiveFace_photo_id")
}

/// Кластер лиц внутри эпизода (предполагаемый один человек)
model FaceCluster {
  id                      Int           @id @default(autoincrement())
  episode_id              Int
  cluster_id              String
  face_count              Int           @default(1)
  avg_quality             Float?
  representative_photo_id Int?
  created_at              String        @default("strftime('%Y-%m-%d %H:%M:%f', 'now')")
  updated_at              String        @default("strftime('%Y-%m-%d %H:%M:%f', 'now')")
  faces                   ArchiveFace[]
  episode                 Episode       @relation(fields: [episode_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([episode_id, cluster_id], map: "idx_FaceCluster_episode_id_cluster_id")
}

/// Журнал кластеризации для аудита
model ClusteringLog {
  id              Int     @id @default(autoincrement())
  episode_id      Int
  cluster_id      String
  action          String
  person_id       Int?
  from_cluster_id String?
  to_cluster_id   String?
  confidence      Float?
  updated_by      String?
  timestamp       String  @default("strftime('%Y-%m-%d %H:%M:%f', 'now')")
  episode         Episode @relation(fields: [episode_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([timestamp], map: "idx_ClusteringLog_timestamp")
  @@index([episode_id, cluster_id], map: "idx_ClusteringLog_episode_id_cluster_id")
}

/// Настройка профиля обработки для разных источников
model ProcessingProfile {
  name              String @id
  description       String
  detector          String @default("scrfd")
  recognizer        String @default("arcface")
  min_face_size     Int    @default(60)
  min_det_score     Float  @default(0.5)
  pose_pitch_max    Float  @default(35.0)
  pose_yaw_max      Float  @default(35.0)
  quality_tier_a    Float  @default(0.7)
  quality_tier_b    Float  @default(0.4)
  similarity_intra  Float  @default(0.55)
  similarity_cross  Float  @default(0.45)
  use_multitemplate Int    @default(1)
  use_bw_twin       Int    @default(1)
  created_at        String @default("strftime('%Y-%m-%d %H:%M:%f', 'now')")
  updated_at        String @default("strftime('%Y-%m-%d %H:%M:%f', 'now')")
}

model Settings {
  key   String @id
  value String
}

model FaissUpdateLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  action    String
  details   String?
  status    String
}
